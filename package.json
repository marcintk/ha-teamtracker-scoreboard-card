{
  "name": "ha-teamtracker-scoreboard-card",
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check:ci": "tsc --noEmit && biome check src/ test/ && prettier --check \"**/*.md\"",
    "format:md": "prettier --write \"**/*.md\"",
    "demo:record": "node scripts/demo/record-demo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ha-card-shared": "github:marcintk/ha-card-shared#v2.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "prettier": "ha-card-shared/prettier.config.json"
}
