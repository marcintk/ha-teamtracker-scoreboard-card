{
  "name": "ha-teamtracker-scoreboard-card",
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check:ci": "tsc --noEmit && biome check src/ test/ && prettier --check \"**/*.md\"",
    "format:md": "prettier --write \"**/*.md\"",
    "demo:record": "node scripts/demo/record-demo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "prettier": {
    "proseWrap": "always",
    "printWidth": 100
  }
}
